# Copy this file to .env and fill in your own values.
# docker-compose.yml reads these automatically.

# Timezone used for "what day is it" logic (chore/routine resets)
TZ=America/New_York

# CalDAV calendar sync (e.g. a Google account with a Google App Password:
# https://myaccount.google.com/apppasswords)
CALDAV_URL=https://www.google.com/calendar/dav/you@gmail.com/events
CALDAV_USERNAME=you@gmail.com
CALDAV_PASSWORD=

# Weather widget location (decimal lat/lon, plus an optional display label
# shown next to the forecast, e.g. "Brooklyn, NY")
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_LOCATION_LABEL=

# Google OAuth (optional, for multi-account Google Calendar sync instead of/
# in addition to CalDAV). Create credentials at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Public URL of the dashboard frontend, used to redirect back after Google OAuth
DASHBOARD_URL=http://localhost:3000/

# Recipe search (optional). Get a free key at https://spoonacular.com/food-api
SPOONACULAR_API_KEY=

# Tide widget (optional). JSON array of { id, name, station }. Find NOAA
# station IDs at https://tidesandcurrents.noaa.gov/map/
TIDE_BEACHES=

# Mealie fallback for recipe search/import (optional). Can also be set from
# the UI's Connected Accounts screen instead. Generate a token in Mealie
# under /user/profile/api-tokens
MEALIE_URL=
MEALIE_API_TOKEN=
